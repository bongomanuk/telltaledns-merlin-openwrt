#!/bin/sh /etc/rc.common
# OpenWrt procd init script for TelltaleDNS.
START=99
STOP=10
USE_PROCD=1

start_service() {
    config_load telltale
    local enabled config
    config_get_bool enabled main enabled 1
    [ "$enabled" = 1 ] || return 0
    config_get config main config /etc/telltale/telltale.toml
    procd_open_instance
    procd_set_param command /usr/bin/telltale run -c "$config"
    procd_set_param respawn 3600 5 5
    procd_set_param file "$config"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
